@model CitasMedicas.Web.Modules.Reservas.Features.BookAppointment.BookAppointmentViewModel
@{
    ViewData["Title"] = "Revisar cita";
}

<section class="specialties-page availability-page">
    <partial name="_ReservationSteps" />
    <div class="specialties-heading">
        <p class="eyebrow">@Model.Doctor.SpecialtyName</p>
        <h1>Revisa los datos antes de confirmar</h1>
        <p class="specialties-intro">Completa tus datos para reservar la cita con @Model.Doctor.Name · @Model.StartsAt.ToString("dddd d 'de' MMMM, HH:mm"). La cita no quedará reservada hasta que confirmes.</p>
    </div>

    <form asp-action="Book" method="post" class="specialty-form reservation-form">
        <input asp-for="DoctorId" type="hidden" />
        <input asp-for="SlotId" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <div class="form-field">
            <label asp-for="PatientName"></label>
            <input asp-for="PatientName" autocomplete="name" class="form-control" />
            <span asp-validation-for="PatientName" class="text-danger"></span>
        </div>
        <div class="form-field">
            <label asp-for="PatientEmail"></label>
            <input asp-for="PatientEmail" autocomplete="email" class="form-control" />
            <small class="form-text text-muted">Usaremos este email para que puedas consultar tus citas futuras en «Mis citas».</small>
            <span asp-validation-for="PatientEmail" class="text-danger"></span>
        </div>
        <div class="form-actions">
            <button type="submit" class="reservation-back" formaction="@Url.Action("BackToAvailability")" formnovalidate>← Volver a los horarios</button>
            <button type="submit" class="select-specialty">Confirmar y reservar cita <span aria-hidden="true">→</span></button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const nameField = document.getElementById("PatientName");
            const emailField = document.getElementById("PatientEmail");
            const storageKey = "appointment-reservation-@Model.DoctorId-@Model.SlotId";

            try {
                const saved = JSON.parse(sessionStorage.getItem(storageKey) || "{}");
                if (!nameField.value) nameField.value = saved.name || "";
                if (!emailField.value) emailField.value = saved.email || "";
                const saveDetails = () => sessionStorage.setItem(storageKey, JSON.stringify({ name: nameField.value, email: emailField.value }));
                nameField.addEventListener("input", saveDetails);
                emailField.addEventListener("input", saveDetails);
            } catch { }
        })();
    </script>
}
