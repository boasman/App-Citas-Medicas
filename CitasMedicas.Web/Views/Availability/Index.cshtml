@model CitasMedicas.Web.Modules.AgendaMedica.Features.GetDoctorAvailability.DoctorAvailabilityViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Horarios disponibles";
    var spanishCulture = CultureInfo.GetCultureInfo("es-ES");
}

<section class="specialties-page availability-page">
    <a class="back-link" asp-controller="Specialties" asp-action="Index">← Especialidades</a>
    <div class="specialties-heading">
        <p class="eyebrow">@Model.Doctor.SpecialtyName</p>
        <h1>Horarios de @Model.Doctor.Name</h1>
        <p class="specialties-intro">Selecciona una fecha y una hora disponible para tu cita.</p>
    </div>

    @if (TempData["AvailabilityMessage"] is string availabilityMessage)
    {
        <div class="availability-warning" role="alert">
            <span class="warning-icon" aria-hidden="true">!</span>
            <span>@availabilityMessage</span>
        </div>
    }

    @if (Model.Message is not null)
    {
        <div class="availability-warning" role="alert">
            <span class="warning-icon" aria-hidden="true">!</span>
            <span>@Model.Message</span>
        </div>
    }

    @if (Model.Dates.Count == 0)
    {
        <div class="empty-state" role="status">
            <h2>No hay horarios disponibles</h2>
            <p>Este profesional no tiene fechas disponibles por el momento.</p>
            <a class="back-link" asp-controller="Specialties" asp-action="Index">Volver a especialidades para elegir otro profesional</a>
        </div>
    }
    else
    {
        <div class="availability-dates">
            @foreach (var date in Model.Dates)
            {
                var dateLabel = date.Date.ToString("dddd d 'de' MMMM 'de' yyyy", spanishCulture);
                dateLabel = char.ToUpper(dateLabel[0], spanishCulture) + dateLabel[1..];
                <section class="availability-date" aria-label="Horarios del @date.Date.ToString("d 'de' MMMM 'de' yyyy", spanishCulture)">
                    <h2>@dateLabel</h2>
                    <div class="time-slots">
                        @foreach (var slot in date.Slots)
                        {
                            <form asp-action="Select" method="post">
                                <input type="hidden" name="doctorId" value="@Model.Doctor.Id" />
                                <input type="hidden" name="slotId" value="@slot.Id" />
                                <button class="time-slot @(Model.SelectedAt == slot.StartsAt ? "time-slot-selected" : "")" type="submit" aria-label="Seleccionar @slot.StartsAt.ToString("HH:mm", spanishCulture) del @date.Date.ToString("d 'de' MMMM 'de' yyyy", spanishCulture)">
                                    @slot.StartsAt.ToString("HH:mm", spanishCulture)
                                </button>
                            </form>
                        }
                    </div>
                </section>
            }
        </div>
    }
</section>
