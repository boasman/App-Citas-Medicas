@model CitasMedicas.Web.Modules.CatalogoMedico.Features.AssignDoctorSpecialty.AssignDoctorSpecialtyViewModel
@{
    ViewData["Title"] = "Asignar especialidad";
}

<section class="specialties-page create-specialty-page">
    <a class="back-link" asp-controller="Specialties" asp-action="Index">← Volver a especialidades</a>
    <div class="specialties-heading">
        <p class="eyebrow">Catálogo médico</p>
        <h1>Asignar especialidad a un médico</h1>
        <p class="specialties-intro">Selecciona el médico y la especialidad que ofrece. La asignación actual será reemplazada.</p>
    </div>

    @if (Model.Doctors.Count == 0)
    {
        <div class="empty-state" role="status">
            <h2>No hay médicos registrados</h2>
            <p>Registra un médico antes de asignarle una especialidad.</p>
            <a class="select-specialty" asp-action="Create">Registrar médico <span aria-hidden="true">→</span></a>
        </div>
    }
    else if (Model.Specialties.Count == 0)
    {
        <div class="empty-state" role="status">
            <h2>No hay especialidades disponibles</h2>
            <p>Crea una especialidad antes de asignarla a un médico.</p>
        </div>
    }
    else
    {
        <form asp-action="AssignSpecialty" method="post" class="specialty-form">
            <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
            <div class="form-field">
                <label asp-for="DoctorId"></label>
                <select asp-for="DoctorId" class="form-control">
                    <option value="0">Selecciona un médico</option>
                    @foreach (var doctor in Model.Doctors)
                    {
                        <option value="@doctor.Id">@doctor.Name — Especialidad actual: @doctor.SpecialtyName</option>
                    }
                </select>
                <span asp-validation-for="DoctorId" class="field-error"></span>
            </div>
            <div class="form-field">
                <label asp-for="SpecialtyId"></label>
                <select asp-for="SpecialtyId" class="form-control">
                    <option value="0">Selecciona una especialidad</option>
                    @foreach (var specialty in Model.Specialties)
                    {
                        <option value="@specialty.Id">@specialty.Name</option>
                    }
                </select>
                <span asp-validation-for="SpecialtyId" class="field-error"></span>
            </div>
            <div class="form-actions">
                <a class="cancel-link" asp-controller="Specialties" asp-action="Index">Cancelar</a>
                <button class="submit-specialty" type="submit">Guardar asignación</button>
            </div>
        </form>
    }
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
